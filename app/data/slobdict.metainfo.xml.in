    <releases>
        <release version="1.2.0" date="2026-03-20">
            <description translatable="no">
                <p>Add a GNOME Shell extension for looking up selected text with Super + D or a four-finger touchpad gesture.</p>
            </description>
        </release>
        <release version="1.1.0" date="2026-03-14">
            <description translatable="no">
                <ul>
                    <li>Look up words from GNOME Activities.</li>
                    <li>Add zoom, find-in-page, and temporary remote-content controls.</li>
                    <li>Add slobdict URI handling and command-line lookup with HTML and Markdown rendering.</li>
                    <li>Sort results case-insensitively and respect the GTK theme in forced dark mode.</li>
                </ul>
            </description>
        </release>
        <release version="1.0.0" date="2025-12-21">
            <description translatable="no">
                <p>Initial release.</p>
            </description>
        </release>
    </releases>
    <content_rating type="oars-1.1" />
</component>
