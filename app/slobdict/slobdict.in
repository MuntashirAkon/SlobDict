#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later

import os
import sys
import signal
import locale
import shutil
import gettext
import glob

is_local = "@local_build@" == "True"
pkgdatadir = "@PKGDATA_DIR@"
localedir = "@LOCALE_DIR@"

# Resolve the bundled locale directory before gettext caches its translation
# function and locale.bindtextdomain is configured.
if 'APPDIR' in os.environ:
    appdir = os.environ['APPDIR']
    pkgdatadir = os.path.join(appdir, pkgdatadir.lstrip('/'))
    localedir = os.path.join(appdir, localedir.lstrip('/'))

gettext.install("@APP_NAME@", localedir)
locale.bindtextdomain("@APP_NAME@", localedir)
locale.textdomain("@APP_NAME@")

sys.dont_write_bytecode = True

signal.signal(signal.SIGINT, signal.SIG_DFL)


if __name__ == "__main__":
    # The AppImage launcher selects its bundled Python and configures GTK.
    # Meson installs this pure-Python package under /usr/lib/python3.*.
    if 'APPDIR' in os.environ:
        appdir = os.environ['APPDIR']
        site_packages = glob.glob(os.path.join(appdir, 'usr', 'lib', 'python3.*', 'site-packages'))
        if site_packages:
            sys.path.insert(1, site_packages[0])

    if is_local:
        # In the local use case, use @APP_NAME@ module from the sourcetree
        sys.path.insert(1, "@PYTHON@")

        # In the local use case the installed schemas go in <builddir>/share
        os.environ["XDG_DATA_DIRS"] = "@SCHEMAS_DIR@:" + os.environ.get(
            "XDG_DATA_DIRS", ""
        )

        shutil.copyfile(
            os.path.join("@BUILD_DIR@", "@APP_NAME@", "constants.py"),
            os.path.join("@SOURCE_DIR@", "@APP_NAME@", "constants.py"),
        )

    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")

    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(pkgdatadir, "@APP_NAME@.gresource"))
    Gio.Resource._register(resource)

    from @APP_NAME@ import main

    sys.exit(main.main())
